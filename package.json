{
  "name": "readbook",
  "private": true,
  "version": "1.0.0",
  "description": "Readbook – The Open Digital Library & E-Book Archives",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-sitemaps.mjs && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "sitemaps:generate": "node scripts/generate-sitemaps.mjs",
    "catalog:generate": "node scripts/generate-public-catalog.mjs",
    "catalog:enrich": "node scripts/enrich-catalog.mjs",
    "catalog:pseo": "node scripts/generate-pseo-catalog.mjs",
    "catalog:sync": "node scripts/enrich-catalog.mjs && node scripts/generate-pseo-catalog.mjs && node scripts/generate-sitemaps.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
